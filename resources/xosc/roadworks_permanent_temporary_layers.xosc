<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
   <FileHeader description="exercise lane layer functionality" author="esmini team" revMajor="1" revMinor="4" date="2026-09-11T10:00:00" />
   <ParameterDeclarations />
   <CatalogLocations>
      <VehicleCatalog>
         <Directory path="../xosc/Catalogs/Vehicles" />
      </VehicleCatalog>
   </CatalogLocations>
   <RoadNetwork>
      <LogicFile filepath="../xodr/roadworks_permanent_temporary_layers.xodr" />
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Car1">
         <CatalogReference catalogName="VehicleCatalog" entryName="car_white"></CatalogReference>
      </ScenarioObject>
      <ScenarioObject name="Car2">
         <CatalogReference catalogName="VehicleCatalog" entryName="car_red"></CatalogReference>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Car1">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="1" laneId="-4" s="10" offset="0.0" />
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0" />
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="${50 / 3.6}" />
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Car2">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="1" laneId="-3" s="25" offset="0.0" layer="permanent" />
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0" />
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="${50 / 3.6}" />
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="LaneChangeStory">
         <Act name="LaneChangeAct">
            <ManeuverGroup maximumExecutionCount="1" name="MyManeuverGroup">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Car2" />
               </Actors>
               <Maneuver name="LaneChangeManeuver">
                  <Event name="LaneChangeEvent" priority="overwrite">
                     <Action name="LaneChangeAction">
                        <PrivateAction>
                           <LateralAction>
                              <LaneChangeAction>
                                 <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="cubic" value="2" />
                                 <LaneChangeTarget>
                                    <AbsoluteTargetLane value="-1" layer="temporary" />
                                 </LaneChangeTarget>
                              </LaneChangeAction>
                           </LateralAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition conditionEdge="none" delay="0" name="LaneChangeCondition">
                              <ByEntityCondition>
                                 <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="Car2" />
                                 </TriggeringEntities>
                                 <EntityCondition>
                                    <DistanceCondition freespace="false" rule="lessOrEqual" value="5.0">
                                       <Position>
                                          <LanePosition laneId="-3" roadId="1" s="85" layer="permanent"></LanePosition>
                                       </Position>
                                    </DistanceCondition>
                                 </EntityCondition>
                              </ByEntityCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="Quit" delay="0.0" conditionEdge="none">
               <ByValueCondition>
                  <SimulationTimeCondition value="10.0" rule="greaterOrEqual" />
               </ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>